# Template for the environment variables passed to instant-news's compose. Copy it to .env (`cp .env.example .env`) and set each value for your environment.
#
# compose cannot read the YAML config file, so the DB credentials and the published port — and only those — appear twice, here and in config.yaml. Keep them equal to the corresponding config.yaml values. db creates the MySQL user and database from the values here, while server and bot connect using the values from config.yaml, so a mismatch leaves server unable to reach the MySQL that came up.
#
# .env is secret just like config.yaml and is untracked by Git (.gitignore). This template is tracked, so never write real credentials in it.

# MySQL database name. Must match database.name in config.yaml.
MYSQL_DATABASE=instant_news

# MySQL user the application connects as. Must match database.user in config.yaml.
MYSQL_USER=instant_news

# Password for the user above. Must match database.password in config.yaml.
# compose refuses to start while this is empty. No value is placed here because a default credential in a template ships to production unchanged.
MYSQL_PASSWORD=

# MySQL root password. The application never uses root; this exists for maintenance and is separate from MYSQL_USER above. No counterpart in config.yaml.
# As with MYSQL_PASSWORD, compose refuses to start while it is empty.
MYSQL_ROOT_PASSWORD=

# Port server is published on. Must match server.port in config.yaml. The same number is used inside and outside the container, so change both together.
INSTANT_NEWS_PORT=8000

# Memory for MySQL's data and indexes (the InnoDB buffer pool). No counterpart in config.yaml. db, server and bot share one host, so never give the pool all of the host's RAM. Aim for a value that covers the whole database yet stays under half of the host's RAM: too small and every read goes to disk, too large and server and bot are starved of memory. Accepts the K, M and G suffixes.
MYSQL_INNODB_BUFFER_POOL_SIZE=1G
