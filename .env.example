# instant-news の compose へ渡す環境変数のひな形。本ファイルを .env としてコピーし(`cp .env.example .env`)、各値を実行環境に合わせて設定してください。
#
# compose は YAML の設定ファイルを読めないため、DB の資格情報と公開ポートだけが config.yaml と二重に現れます。ここの値は config.yaml の対応する値と一致させてください。db は本ファイルの値で MySQL の利用者とデータベースを作り、server と bot は config.yaml の値で繋ぎにいくため、食い違うと server は起動した MySQL へ繋げません。
#
# .env は config.yaml と同じく秘密であり、Git 追跡対象外です(.gitignore)。ひな形である本ファイルは追跡対象のため、実際の資格情報を書かないでください。

# MySQL のデータベース名。config.yaml の database.name と一致させること。
MYSQL_DATABASE=instant_news

# アプリケーションが使う MySQL の利用者。config.yaml の database.user と一致させること。
MYSQL_USER=instant_news

# 上記の利用者のパスワード。config.yaml の database.password と一致させること。
# 空のまま起動すると compose が拒む。ひな形に既定の資格情報を書くと、変更されないまま本番へ出るため、ここには値を置かない。
MYSQL_PASSWORD=

# MySQL の root のパスワード。アプリケーションは root を使わず、保守用に設けるもので、上記の MYSQL_USER とは別である。config.yaml に対応する値は無い。
# MYSQL_PASSWORD と同じく、空のまま起動すると compose が拒む。
MYSQL_ROOT_PASSWORD=

# server を公開するポート。config.yaml の server.port と一致させること。コンテナの内と外で同じ番号を使うため、変える場合は両方を合わせる。
INSTANT_NEWS_PORT=8000

# MySQL がデータと索引を載せるメモリ(InnoDB バッファプール)。config.yaml に対応する値は無い。db・server・bot は同じホストに同居するため、ホストの搭載メモリを全て与えてはならない。目安は、データベースの総量を賄えて、かつホストの搭載メモリの半分を超えない値。小さすぎると読むたびにディスクへ行き、大きすぎると server と bot がメモリを奪われる。K・M・G の接尾辞が使える。
MYSQL_INNODB_BUFFER_POOL_SIZE=1G
